FROM ghcr.io/cross-rs/armv7-unknown-linux-gnueabihf:edge

ENV DEBIAN_FRONTEND=noninteractive
RUN echo "Debian arch: $CROSS_DEB_ARCH"

# Bake the toolchain into the image: cross mounts the project at a version
# dependent path (/project or the host path), so don't rely on the mount.
COPY toolchain/arm-rockchip830-linux-uclibcgnueabihf /opt/arm-rockchip830-linux-uclibcgnueabihf

ENV PATH=$PATH:/opt/arm-rockchip830-linux-uclibcgnueabihf/bin
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-rockchip830-linux-uclibcgnueabihf-gcc
